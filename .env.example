# Claim extractor: "llm" (recommended) or "sentence" (no LLM, splits answer into sentences)
VERIFAITH_EXTRACTOR=llm
# Any OpenAI-compatible chat endpoint works (Groq, OpenAI, Together, vLLM, Ollama...)
VERIFAITH_LLM_BASE_URL=https://api.groq.com/openai/v1
VERIFAITH_LLM_API_KEY=
VERIFAITH_LLM_MODEL=llama-3.3-70b-versatile

# Entailment model (Hugging Face id)
VERIFAITH_NLI_MODEL=cross-encoder/nli-deberta-v3-base

# Service: comma-separated API keys. Leave empty ONLY for local development.
VERIFAITH_API_KEYS=
VERIFAITH_MAX_ANSWER_CHARS=8000
VERIFAITH_MAX_CONTEXT_CHARS=60000
VERIFAITH_MAX_BATCH_ITEMS=20
